{
  "version": 1,
  "id": "javascript",
  "name": "JavaScript",
  "extensions": ["js", "mjs", "cjs"],
  "autoClosingPairs": [["(", ")"], ["[", "]"], ["{", "}"], ["\"", "\""], ["'", "'"], ["`", "`"]],
  "lineComment": "//",
  "states": {
    "root": [
      { "match": "//.*", "scope": "comment.line" },
      { "begin": "/\\*", "end": "\\*/", "scope": "comment.block" },
      { "begin": "`", "end": "(?<!\\\\)`", "scope": "string.template" },
      { "match": "\"[^\"\\\\]*+(?:\\\\.[^\"\\\\]*+)*+\"?", "scope": "string" },
      { "match": "'[^'\\\\]*+(?:\\\\.[^'\\\\]*+)*+'?", "scope": "string" },
      { "match": "/(?<![\\w)\\]$]\\s{0,20}/)(?![/*])(?:[^/\\\\\\[\\n]++|\\\\.|\\[(?:[^\\]\\\\\\n]++|\\\\.)*+\\])++/[dgimsuvy]*+", "scope": "regexp" },
      { "match": "/(?<=\\b(?:return|typeof|case|throw|yield|await|void|delete|in|of|else|do|new)\\s{1,20}/)(?![/*])(?:[^/\\\\\\[\\n]++|\\\\.|\\[(?:[^\\]\\\\\\n]++|\\\\.)*+\\])++/[dgimsuvy]*+", "scope": "regexp" },
      { "match": "0[xX][\\da-fA-F_]+n?|0[bB][01_]+n?|0[oO][0-7_]+n?|\\d[\\d_]*(?:\\.\\d[\\d_]*)?(?:[eE][+-]?\\d+)?n?", "scope": "number" },
      { "words": ["true", "false", "null", "undefined", "NaN", "Infinity"], "scope": "constant.language" },
      { "words": ["if", "else", "for", "while", "do", "switch", "case", "default", "break", "continue", "return", "throw", "try", "catch", "finally", "await", "yield", "import", "export", "from", "as"], "scope": "keyword.control" },
      { "words": ["var", "let", "const", "function", "class", "extends", "new", "delete", "typeof", "instanceof", "in", "of", "void", "async", "static", "this", "super", "with", "debugger", "enum"], "scope": "keyword" },
      { "match": "[A-Z][A-Z0-9_$]+(?![\\w$])", "scope": "constant" },
      { "match": "[A-Z][\\w$]*", "scope": "type" },
      { "match": "[A-Za-z_$][\\w$]*(?=\\s*\\()", "scope": "function" }
    ]
  }
}